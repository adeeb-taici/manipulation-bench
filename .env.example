# API Keys — uncomment and fill in the providers you want to use.
# OpenRouter is the recommended path for most models in this repo
# (Claude / GPT / Gemini / Grok / Llama).
# OPENROUTER_API_KEY=

# DeepSeek's reasoning model needs the official DeepSeek API for tool calls
# (OpenRouter rejects it under privacy guardrails). See docs/provider_quirks.md.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Direct provider keys are accepted but not required if you go through OpenRouter.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
